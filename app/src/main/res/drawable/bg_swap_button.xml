<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/secondary_accent_glow">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#202F4F"
                android:endColor="#152139"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="@color/secondary_accent" />
            <size
                android:width="50dp"
                android:height="50dp" />
        </shape>
    </item>
</ripple>
